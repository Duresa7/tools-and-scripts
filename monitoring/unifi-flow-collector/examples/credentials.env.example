# CUSTOMIZE: These variable names must match the TOML env-name fields.
# Populate the installed file through your credential manager; keep it mode 0600.
# Never store real credentials in this example or anywhere in the repository.
UNIFI_API_KEY=
SPLUNK_HEC_TOKEN=
# CUSTOMIZE: For session login instead of an API key, supply UNIFI_PASSWORD
# and set username, password_env, and an empty api_key_env in local TOML.
UNIFI_PASSWORD=

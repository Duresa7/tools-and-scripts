[Unit]
Description=Sync a Cloudflare IP list with GitHub's webhook ranges
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# CUSTOMIZE: A 0600 file holding one line, CLOUDFLARE_API_TOKEN=<token>.
EnvironmentFile=/etc/cloudflare-webhook-ranges/token.env
# CUSTOMIZE: Match the installed script and configuration paths.
ExecStart=/usr/bin/python3 /usr/local/bin/cloudflare_webhook_ranges.py --config /etc/cloudflare-webhook-ranges/config.local.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# CUSTOMIZE: The node_exporter textfile directory the metrics are written to.
ReadWritePaths=/var/lib/prometheus/node-exporter
